@model DashboardViewModel
@{
  ViewData["Title"] = "CRM Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div><h4 class="mb-1">CRM Dashboard</h4><p class="text-muted mb-0">Your customer activity at a glance.</p></div>
  <a asp-controller="Customers" asp-action="Create" class="btn btn-primary"><i class="icon-base bx bx-plus me-1"></i> Add customer</a>
</div>
<div class="row g-4 mb-4">
  <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><p class="mb-2 text-muted">Customers</p><h3 class="mb-0">@Model.CustomerCount</h3></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><p class="mb-2 text-muted">Open leads</p><h3 class="mb-0">@Model.LeadCount</h3></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><p class="mb-2 text-muted">Pipeline value</p><h3 class="mb-0">@Model.PipelineValue.ToString("C0")</h3></div></div></div>
  <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><p class="mb-2 text-muted">Open tasks</p><h3 class="mb-0">@Model.OpenTaskCount</h3></div></div></div>
</div>
<div class="row g-4">
  <div class="col-lg-7"><div class="card h-100"><div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0">Recent leads</h5><span class="badge bg-label-primary">@Model.LeadCount total</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Lead</th><th>Status</th><th class="text-end">Value</th></tr></thead><tbody>@foreach (var lead in Model.RecentLeads) { <tr><td><strong>@lead.Name</strong><br /><small class="text-muted">@lead.Email</small></td><td><span class="badge bg-label-info">@lead.Status</span></td><td class="text-end">@lead.EstimatedValue.ToString("C0")</td></tr> }</tbody></table></div></div></div>
  <div class="col-lg-5"><div class="card h-100"><div class="card-header"><h5 class="mb-0">Upcoming tasks</h5></div><div class="card-body"><ul class="list-unstyled mb-0">@foreach (var task in Model.UpcomingTasks) { <li class="d-flex align-items-start mb-3"><i class="icon-base bx bx-checkbox text-primary mt-1 me-2"></i><div><strong>@task.Title</strong><br /><small class="text-muted">Due @task.DueDate.ToString("dd MMM yyyy")</small></div></li> } @if (Model.UpcomingTasks.Count == 0) { <li class="text-muted">No open tasks.</li> }</ul></div></div></div>
</div>