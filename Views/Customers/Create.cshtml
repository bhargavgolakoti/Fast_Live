@model Customer
@{ ViewData["Title"] = "Add customer"; }
<div class="row"><div class="col-lg-8"><div class="d-flex justify-content-between align-items-center mb-4"><h4 class="mb-0">Add customer</h4><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div><div class="card"><div class="card-body"><form asp-action="Create" method="post"><partial name="_CustomerForm" model="Model" /><div class="mt-4"><button type="submit" class="btn btn-primary">Create customer</button></div></form></div></div></div></div>
@section PageScripts { <partial name="_ValidationScriptsPartial" /> }