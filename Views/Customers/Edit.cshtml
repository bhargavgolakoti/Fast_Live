@model Customer
@{ ViewData["Title"] = "Edit customer"; }
<div class="row"><div class="col-lg-8"><div class="d-flex justify-content-between align-items-center mb-4"><h4 class="mb-0">Edit customer</h4><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div><div class="card"><div class="card-body"><form asp-action="Edit" method="post"><input type="hidden" asp-for="Id" /><partial name="_CustomerForm" model="Model" /><div class="mt-4"><button type="submit" class="btn btn-primary">Save changes</button></div></form></div></div></div></div>
@section PageScripts { <partial name="_ValidationScriptsPartial" /> }