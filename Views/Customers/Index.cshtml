@model IReadOnlyList<Customer>
@{
  ViewData["Title"] = "Customers";
  var search = ViewData["Search"] as string;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div><h4 class="mb-1">Customers</h4><p class="text-muted mb-0">Manage your customer records.</p></div>
  <a asp-action="Create" class="btn btn-primary"><i class="icon-base bx bx-plus me-1"></i> Add customer</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
<div class="card"><div class="card-body border-bottom"><form method="get" class="row g-2"><div class="col-sm-8 col-md-6"><label class="visually-hidden" for="search">Search customers</label><input id="search" name="search" value="@search" class="form-control" placeholder="Search name, company, email, or status" /></div><div class="col-auto"><button class="btn btn-outline-primary" type="submit"><i class="icon-base bx bx-search me-1"></i> Search</button></div>@if (!string.IsNullOrWhiteSpace(search)) { <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div> }</form></div><div class="table-responsive text-nowrap"><table class="table"><thead><tr><th>Customer</th><th>Company</th><th>Phone</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@if (Model.Count == 0) { <tr><td colspan="5" class="text-center py-5 text-muted">No customers found.</td></tr> } @foreach (var customer in Model) { <tr><td><strong>@customer.Name</strong><br /><small class="text-muted">@customer.Email</small></td><td>@(customer.Company ?? "-")</td><td>@(customer.Phone ?? "-")</td><td><span class="badge bg-label-@(customer.Status == "Active" ? "success" : "warning")">@customer.Status</span></td><td class="text-end"><a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary" aria-label="Edit @customer.Name"><i class="icon-base bx bx-edit-alt"></i></a><form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline" onsubmit="return confirm('Delete @customer.Name?');"><button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete @customer.Name"><i class="icon-base bx bx-trash"></i></button></form></td></tr> }</tbody></table></div></div>