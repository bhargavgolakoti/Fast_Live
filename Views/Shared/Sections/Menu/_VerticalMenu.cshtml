@{
  var currentPath = ViewContext.HttpContext.Request.Path.Value ?? string.Empty;
}
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
  <div class="app-brand demo">
    <a asp-controller="Dashboards" asp-action="Index" class="app-brand-link">
      <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
      <span class="app-brand-text demo menu-text fw-bold ms-2">CRM</span>
    </a>
    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto"><i class="icon-base bx bx-chevron-left d-block d-xl-none"></i></a>
  </div>
  <div class="menu-divider mt-0"></div><div class="menu-inner-shadow"></div>
  <ul class="menu-inner py-1">
    <li class='menu-item@(currentPath.StartsWith("/Dashboards") ? " active" : "")'><a asp-controller="Dashboards" asp-action="Index" class="menu-link"><i class="menu-icon icon-base bx bx-home-smile"></i><div>Dashboard</div></a></li>
    <li class='menu-item@(currentPath.StartsWith("/Customers") ? " active" : "")'><a asp-controller="Customers" asp-action="Index" class="menu-link"><i class="menu-icon icon-base bx bx-user"></i><div>Customers</div></a></li>
    <li class="menu-header small text-uppercase"><span class="menu-header-text">Quick actions</span></li>
    <li class="menu-item"><a asp-controller="Customers" asp-action="Create" class="menu-link"><i class="menu-icon icon-base bx bx-plus-circle"></i><div>Add customer</div></a></li>
  </ul>
</aside>