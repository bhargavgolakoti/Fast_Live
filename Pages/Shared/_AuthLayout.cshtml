@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | Afterglow</title>
    <meta name="description" content="Afterglow private social space">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/auth.css" asp-append-version="true">
</head>
<body>
    <main class="auth-page">
        <section class="auth-visual d-none d-lg-flex">
            <div class="visual-copy">
                <span class="eyebrow">AFTERGLOW / PRIVATE SOCIAL</span>
                <h1>Make room<br>for <em>real</em> life.</h1>
                <p>A quiet, expressive place for your people, ideas, and moments between.</p>
            </div>
            <div class="visual-orbit"><i class="bi bi-stars"></i></div>
        </section>
        <section class="auth-panel">
            <div class="auth-card">
                <a class="brand" href="/"><span class="brand-mark"><i class="bi bi-moon-stars-fill"></i></span> Afterglow</a>
                @RenderBody()
            </div>
            <p class="auth-footer"><i class="bi bi-shield-check"></i> Private by default · Built for your people</p>
        </section>
    </main>
@RenderSection("Scripts", required: false)
</body>
</html>
