@page
@model LiveCounter.Pages.Account.ForgotPasswordModel
@{
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset your path";
}
<div class="auth-heading">
    <span class="eyebrow">ACCOUNT RECOVERY</span>
    <h2>Find your way back.</h2>
    <p>Send a private request to the support queue and we will help you securely.</p>
</div>
@if (Model.Submitted)
{
    <div class="alert alert-success auth-success" role="status"><i class="bi bi-check-circle-fill"></i><span>@Model.Message</span></div>
    <a class="btn btn-primary auth-submit text-center" href="/Account/Login">Return to sign in <i class="bi bi-arrow-right"></i></a>
}
else
{
    <form method="post" class="auth-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger auth-alert" role="alert"></div>
        <div class="field-group"><label asp-for="Input.Email" class="form-label">Email address</label><div class="input-wrap"><i class="bi bi-envelope" aria-hidden="true"></i><input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus></div><span asp-validation-for="Input.Email" class="field-error"></span></div>
        <button class="btn btn-primary auth-submit" type="submit"><span>Send secure request</span><i class="bi bi-send"></i></button>
    </form>
}
<div class="auth-switch"><a class="form-link" href="/Account/Login"><i class="bi bi-arrow-left"></i> Back to sign in</a></div>
@section Scripts {
    <script src="~/auth.js" asp-append-version="true"></script>
}
